# Piper binary. If piper-tts installs correctly, "piper" is usually enough.
PIPER_BIN=piper

# Default Chinese medium voice. download_voice.sh places files here.
MODEL_DIR=./models
PIPER_MODEL=./models/zh_CN-chaowen-medium.onnx
PIPER_CONFIG=./models/zh_CN-chaowen-medium.onnx.json

# Audio output. Leave empty or use "default" for ALSA default.
# Examples: default, plughw:0,0, plughw:1,0, hw:0,0
AUDIO_DEVICE=default
APLAY_BIN=aplay

# Optional extra Python packages path for Piper subprocess.
# Useful when Jetson PyTorch is installed outside this venv.
EXTRA_PYTHONPATH=

# Cache and API.
CACHE_DIR=./cache
HOST=0.0.0.0
PORT=8777

# Piper voice tuning. Smaller length-scale means faster speech.
DEFAULT_LENGTH_SCALE=0.90
DEFAULT_NOISE_SCALE=0.667
DEFAULT_NOISE_W=0.8

# Text handling.
MAX_TEXT_CHARS=600
MAX_CHUNK_CHARS=70
ENABLE_TRADITIONAL_TO_SIMPLIFIED=true
ENABLE_CACHE=true

# For normal playback, stream Piper raw PCM directly into aplay.
# This avoids writing temporary WAV files before speaking.
ENABLE_STREAM_PLAYBACK=true

# Keep Piper voice loaded inside the Python server process.
# This avoids launching the piper CLI and reloading g2pw/torch/model every sentence.
ENABLE_INPROCESS_PIPER=true

# Use Hugging Face local cache for bert-base-chinese after first successful warm-up.
# Set false on a clean install if the tokenizer has not been cached yet.
ENABLE_HF_OFFLINE=false

# Runtime.
SYNTH_TIMEOUT_SECONDS=45
LOG_LEVEL=INFO
