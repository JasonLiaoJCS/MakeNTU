# Copy to ~/.config/makentu/wake-bridge.env.
# This file is loaded by the makentu-wake-bridge user systemd service.

# ESP32-S3 BLE: pin the MAC seen by scan-only for the most stable Jetson/BlueZ behavior.
ESP32_BLE=1
ESP32_BLE_ADDRESS=
ESP32_BLE_ADAPTER=hci0
ESP32_BLE_SCAN_DUPLICATES=1
FAN_MIN_PWM=96

# Voice/focus server on the Windows/Tailscale side.
SERVER_URL=http://192.168.1.127:8766/voice-chat
FOCUS_SERVER_URL=http://192.168.1.127:8766/focus-check

# Optional runtime tuning.
DEVICE_READY_TIMEOUT=45
MAKE_NTU_TTS_VOLUME_GAIN=3.6
BEEP_PLAYER=aplay
BEEP_VOLUME=0.55
MUSIC_MPV_VOLUME=150
MUSIC_MPV_VOLUME_MAX=200
TEMP_ROOM_UART_INTERVAL_SEC=10
TEMP_ROOM_UART_MAX_AGE_SEC=30
